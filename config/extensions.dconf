[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_44939660918378'>, 'params': <@a{sv} {}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}}
rounded-blur-found=false

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
pipeline='pipeline_default'
sigma=30
static-blur=false

[blur-my-shell/popup]
blur=false

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[dash-to-dock]
background-color='rgb(28,28,28)'
background-opacity=0.80000000000000004
custom-theme-running-dots-color='rgb(250,250,251)'
custom-theme-shrink=true
dash-max-icon-size=48
disable-overview-on-startup=true
dock-position='BOTTOM'
height-fraction=0.75
hot-keys=false
isolate-monitors=false
isolate-workspaces=false
multi-monitor=true
show-apps-at-top=true
show-mounts=false
show-mounts-network=false
show-show-apps-button=true

[globalmenu]
mac-shortcut-symbols=true
show-logo-menu=false

[gtk4-ding]
free-position-icons=true
icon-size='small'
show-drop-place=false
show-home=false
show-network-volumes=true
show-trash=false
start-corner='top-right'

[kiwi]
dock-adaptive-colors=true
dock-border=false
dock-styling=true
dock-trash-animation=true
enable-app-window-buttons=true
enable-firefox-styling=false
enable-launchpad-app=false
hide-activities-button=true
move-window-to-new-workspace=false
overview-seamless-zoom=false
overview-wallpaper-background=false
panel-blur=true
panel-opaque-on-window=true
panel-transparency=true
panel-transparency-level=0
show-tiling-title-menu=false
show-window-controls=false
show-window-controls-fullscreen-only=false
show-window-title=false
show-window-title-icon=true
skip-overview-on-login=false

[kiwimenu]
activity-menu-visibility=false
icon=10

[multi-monitors-bar]
available-indicators=['KiwiMenuButton', 'WeatherOrNot', 'kiwi-media']
date-time-position='right-after-tray'
force-workspaces-on-all-displays=true
screenshot-on-all-monitors=false
show-activities=false
show-app-menu=false
show-date-time=true
show-overview-on-extended-monitors=false
show-panel=true
thumbnails-slider-position='auto'

[nexstage]
activate-mode='raise'
keybinding-activate=['']
keybinding-next=['']
keybinding-prev=['']
keybinding-toggle=['']
layout-mode='vertical'
merge-map='{}'
order-map='{"com.desktop.ding.desktop|org.gnome.Ptyxis.desktop":0,"org.gnome.Nautilus.desktop":1}'
persistent-mode=false
show-panel-background=false

[ormic-launcher]
background-style='solid'
enable-edge-trigger=false
grid-columns=0
grid-icon-size=76
launcher-height=640
launcher-width=800
modal-grab=false
overlay-dim=0.0
replace-app-grid=true
show-indicator=false
show-search-bar=true
toggle-ormic-launcher=['F4']

[pip-on-top]
stick=true

[rounded-window-corners-reborn]
debug-mode=false

[rudra]
font-name='Adwaita Sans 11'
hover-color='#e01b24'
selection-color='#970d0d'
toggle-launcher=['<Super>space']

[three-finger-show-desktop]
launcher-extension-uuid='oramic-launcher@skye-xd.github.io'
animation-duration=500
app-expose-toggle=['<Control>Down']
easing='ease-out-expo'
mission-control-toggle=['<Control>Up']
panel-drag-primary-only=true
peek-px=16
pinch-commit-progress=0.34999999999999998
pinch-opens-launchpad=true
pinch-restore-scale=0.73999999999999999
pinch-show-scale=1.3500000000000001
show-desktop-toggle=['<Control><Super>Up', '<Super>d']
suppress-other-vertical-swipes=true
suppress-startup-overview=true
swipe-down-action='app-expose'
swipe-finger-count=4
swipe-up-action='mission-control'

[weatherornot]
position='right'

[wiggle]
hide-cursor=true
