#!/usr/bin/python3 -I
"""Start apps in X11 mode so they hand their menubar to the global menu.

Electron/Chromium (and Firefox) export their menubar over
com.canonical.dbusmenu only under X11: they register the X window id with the
AppMenu registrar (globalmenu's dbusMenu.js), which has no Wayland equivalent
on GNOME. This keeps a copy of each such app's .desktop file in
~/.local/share/applications (which shadows the packaged one) with its Exec
lines changed to start in X11 mode.

  x11-menus            status: what is overridden, what is new
  x11-menus sync       add overrides for new Electron apps, regenerate
                          ones whose packaged file changed, drop ones whose
                          app was uninstalled (run by x11-menus.path)
  x11-menus sync --adopt   also take over hand-made overrides
  x11-menus sync --notify  desktop notification for apps added
  x11-menus remove ID  delete an override and never re-add it
  x11-menus allow ID   undo `remove`

Electron apps are found automatically. Apps that need a different mode, or
are not Electron, are listed in MODES. A managed override carries
X-GlobalMenu-Source/-Mode keys; anything without them is left alone.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
OVERRIDES = HOME / '.local/share/applications'
IGNORE_FILE = HOME / '.config/x11-menus/ignore'
BACKUPS = HOME / '.local/share/yet-another-gnomintosh/backups'
SOURCES = [
    Path('/usr/share/applications'),
    Path('/usr/local/share/applications'),
    Path('/var/lib/flatpak/exports/share/applications'),
    HOME / '.local/share/flatpak/exports/share/applications',
    Path('/var/lib/snapd/desktop/applications'),
]
SNAP_ROOT = Path('/var/lib/snapd/snap')

FLAG = '--ozone-platform=x11'
PREFIXES = {
    # Discord's updater relaunches the app without our arguments; with no
    # Wayland socket in sight, Chromium's auto-detection picks X11 instead.
    # Anything the app spawns inherits this.
    'env': 'env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11',
    'moz': 'env MOZ_ENABLE_WAYLAND=0',
}
# desktop id -> mode, for apps detection would miss or get wrong.
# 'flag' inserts --ozone-platform=x11; 'env'/'moz' prefix the Exec line.
MODES = {
    'discord.desktop': 'env',
    'google-chrome.desktop': 'flag',
    'com.google.Chrome.desktop': 'flag',
    # Also needs widget.gtk.global-menu.enabled in the profile's user.js.
    'org.mozilla.firefox.desktop': 'moz',
}
REGISTRAR = 'com.canonical.AppMenu.Registrar'

HEADER = """\
# Generated by ~/.local/bin/x11-menus (yet-another-gnomintosh): starts the app in X11 mode so it
# hands its menubar to the global menu. `x11-menus remove {id}` to revert.
"""


def read_ignore():
    try:
        return {l.strip() for l in IGNORE_FILE.read_text().splitlines() if l.strip()}
    except FileNotFoundError:
        return set()


def write_ignore(ids):
    IGNORE_FILE.parent.mkdir(parents=True, exist_ok=True)
    IGNORE_FILE.write_text(''.join(f'{i}\n' for i in sorted(ids)))


def entry_value(text, key):
    """A key from the [Desktop Entry] group."""
    group = None
    for line in text.splitlines():
        if line.startswith('['):
            group = line.strip()
        elif group == '[Desktop Entry]' and line.startswith(key + '='):
            return line[len(key) + 1:].strip()
    return None


def tokens(exec_line):
    """(start, end, text) for each word of an Exec value, quotes respected."""
    out, i, n = [], 0, len(exec_line)
    while i < n:
        if exec_line[i].isspace():
            i += 1
            continue
        start, quoted = i, False
        while i < n and (quoted or not exec_line[i].isspace()):
            if exec_line[i] == '\\' and quoted:
                i += 1
            elif exec_line[i] == '"':
                quoted = not quoted
            i += 1
        out.append((start, i, exec_line[start:i].strip('"')))
    return out


def program(exec_line):
    """Index into tokens() of the program, skipping an `env ...` prefix."""
    toks = tokens(exec_line)
    i = 0
    if toks and os.path.basename(toks[0][2]) == 'env':
        i = 1
        while i < len(toks):
            t = toks[i][2]
            if t == '-u':
                i += 2
            elif t.startswith('-') or ('=' in t and not t.startswith('/')):
                i += 1
            else:
                break
    return toks, i


def flatpak_id(exec_line):
    toks, i = program(exec_line)
    if i < len(toks) and os.path.basename(toks[i][2]) == 'flatpak':
        for _s, _e, t in toks[i + 1:]:
            if t != 'run' and not t.startswith('-'):
                return t
    return None


def is_electron_dir(d):
    d = Path(d)
    return (d / 'resources/app.asar').exists() or (d / 'resources/app/package.json').exists()


def is_electron(exec_line):
    fid = flatpak_id(exec_line)
    if fid:
        r = subprocess.run(['flatpak', 'info', '--show-metadata', fid],
                           capture_output=True, text=True)
        return 'org.electronjs.Electron2.BaseApp' in r.stdout

    toks, i = program(exec_line)
    if i >= len(toks):
        return False
    prog = toks[i][2]

    # Snaps run through /usr/bin/snap; look inside the snap itself.
    if prog.startswith(str(SNAP_ROOT / 'bin') + '/'):
        snap = SNAP_ROOT / os.path.basename(prog).split('.')[0] / 'current'
        return any(is_electron_dir(p.parent.parent)
                   for p in snap.glob('**/resources/app.asar')
                   if len(p.relative_to(snap).parts) <= 4)

    path = prog if prog.startswith('/') else (subprocess.run(
        ['sh', '-c', 'command -v "$1"', '_', prog],
        capture_output=True, text=True).stdout.strip())
    if not path or not os.path.isfile(path):
        return False
    path = os.path.realpath(path)
    if is_electron_dir(os.path.dirname(path)):
        return True

    # A launcher script: follow the absolute paths it mentions (system
    # electron + app.asar, or a bundled app in /opt).
    with open(path, 'rb') as f:
        head = f.read(65536)
    if not head.startswith(b'#!'):
        return False
    text = head.decode(errors='replace')
    for p in re.findall(r'/[\w.+/-]+', text):
        if p.endswith('.asar') or (os.path.isdir(p) and is_electron_dir(p)) \
                or (os.path.isfile(p) and is_electron_dir(os.path.dirname(p))):
            return True
    return False


def rewrite_exec(exec_line, mode):
    if mode in PREFIXES:
        return f'{PREFIXES[mode]} {exec_line}'
    toks, i = program(exec_line)
    fid = flatpak_id(exec_line)
    if fid:
        # Arguments after the app id go to the app.
        i = next(j for j, t in enumerate(toks) if t[2] == fid)
    end = toks[i][1]
    return f'{exec_line[:end]} {FLAG}{exec_line[end:]}'


def generate(src, mode):
    did = src.name
    out = []
    for line in src.read_text().splitlines():
        if line.startswith('Exec='):
            line = 'Exec=' + rewrite_exec(line[5:], mode)
        out.append(line)
        if line.strip() == '[Desktop Entry]':
            out.append(HEADER.format(id=did).rstrip('\n'))
            out.append(f'X-GlobalMenu-Source={src}')
            out.append(f'X-GlobalMenu-Mode={mode}')
    return '\n'.join(out) + '\n'


def flatpak_grant(fid):
    """Under Wayland a fallback-x11 flatpak gets no X socket, and the menu
    needs the registrar's bus name."""
    subprocess.run(['flatpak', 'override', '--user', '--socket=x11',
                    f'--talk-name={REGISTRAR}', fid], check=True)


def scan():
    """desktop id -> (source path, mode or None) for every packaged app."""
    found = {}
    for d in SOURCES:
        for src in sorted(d.glob('*.desktop')) if d.is_dir() else []:
            if src.name in found:
                continue        # earlier dirs shadow later ones, like XDG
            try:
                text = src.read_text()
            except (OSError, UnicodeDecodeError):
                continue
            exec_line = entry_value(text, 'Exec')
            if not exec_line or entry_value(text, 'Hidden') == 'true':
                continue
            mode = MODES.get(src.name) or ('flag' if is_electron(exec_line) else None)
            found[src.name] = (src, mode)
    return found


def managed(path):
    text = path.read_text()
    src = entry_value(text, 'X-GlobalMenu-Source')
    return (Path(src), entry_value(text, 'X-GlobalMenu-Mode')) if src else None


def notify(msg):
    subprocess.run(['notify-send', '-a', 'Global menu', '-i', 'preferences-desktop',
                    'Global menu', msg], check=False)


def sync(adopt=False, notify_added=False):
    ignore = read_ignore()
    apps = scan()
    added, changed = [], False

    # Existing managed overrides: drop orphans, regenerate stale ones.
    for path in sorted(OVERRIDES.glob('*.desktop')):
        m = managed(path)
        if not m:
            continue
        src, mode = m
        if not src.exists() or path.name in ignore:
            path.unlink()
            print(f'removed  {path.name} ({"uninstalled" if not src.exists() else "ignored"})')
            changed = True
            continue
        new_mode = (apps.get(path.name) or (src, None))[1] or mode
        if src.stat().st_mtime > path.stat().st_mtime or new_mode != mode:
            path.write_text(generate(src, new_mode))
            print(f'updated  {path.name}')
            changed = True

    for did, (src, mode) in apps.items():
        if not mode or did in ignore:
            continue
        dest = OVERRIDES / did
        if dest.exists() and (managed(dest) or not adopt):
            continue
        if dest.exists():
            BACKUPS.mkdir(parents=True, exist_ok=True)
            os.rename(dest, BACKUPS / f'{did}.pre-x11-menus')
        dest.write_text(generate(src, mode))
        fid = flatpak_id(entry_value(src.read_text(), 'Exec'))
        if fid:
            flatpak_grant(fid)
        name = entry_value(src.read_text(), 'Name') or did
        print(f'added    {did} ({mode})')
        added.append(name)
        changed = True

    if changed:
        subprocess.run(['update-desktop-database', str(OVERRIDES)], check=False)
    if added and notify_added:
        notify(f'{", ".join(added)} will open in X11 mode so its menus show in the top bar. '
               'If they do not, the app may draw its own title bar.')


def status():
    ignore = read_ignore()
    for did, (src, mode) in sorted(scan().items()):
        if not mode:
            continue
        dest = OVERRIDES / did
        if did in ignore:
            state = 'ignored'
        elif not dest.exists():
            state = 'NEW (sync adds it)'
        elif managed(dest):
            state = 'managed'
        else:
            state = 'hand-made (sync --adopt takes over)'
        print(f'{did:50} {mode:5} {state}')


def main(argv):
    cmd = argv[1] if len(argv) > 1 else 'status'
    if cmd == 'status':
        status()
    elif cmd == 'sync':
        sync(adopt='--adopt' in argv, notify_added='--notify' in argv)
    elif cmd in ('remove', 'allow') and len(argv) == 3:
        did = argv[2] if argv[2].endswith('.desktop') else argv[2] + '.desktop'
        ignore = read_ignore()
        if cmd == 'remove':
            ignore.add(did)
            dest = OVERRIDES / did
            if dest.exists() and managed(dest):
                fid = flatpak_id(entry_value(dest.read_text(), 'Exec'))
                dest.unlink()
                subprocess.run(['update-desktop-database', str(OVERRIDES)], check=False)
                if fid:
                    print(f'note: the flatpak keeps its x11 socket and registrar '
                          f'permission; drop them from '
                          f'~/.local/share/flatpak/overrides/{fid} if wanted')
        else:
            ignore.discard(did)
        write_ignore(ignore)
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main(sys.argv)
