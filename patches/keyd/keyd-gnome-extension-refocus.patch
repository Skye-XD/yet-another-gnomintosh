+	const title = win ? win.get_title() : '';
+
+	send(`${cls}	${title}\n`);
+}
+
+let in_system_modal = false;
+
 export default class KeydExtension extends Extension {
 	enable() {
-		Shell.WindowTracker.get_default().connect('notify::focus-app', () => {
-			const win = global.display.focus_window;
